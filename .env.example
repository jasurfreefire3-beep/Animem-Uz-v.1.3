# Google akkauntdan (Security -> 2-Step Verification -> App passwords) 16 xonali maxsus parol oling:
GMAIL_USER="support@animem.uz"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# 2-variant: Custom Domain SMTP (cPanel, Hostinger, Yandex, Mail.ru)

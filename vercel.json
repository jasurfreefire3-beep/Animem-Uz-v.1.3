{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://site--anime--jpdsl9nq68nb.code.run/api/:path*"
    },
    {
      "source": "/stream/:path*",
      "destination": "https://site--anime--jpdsl9nq68nb.code.run/stream/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

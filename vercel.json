{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ss-test.wasmer.app/api/:path*"
    },
    {
      "source": "/stream/:path*",
      "destination": "https://ss-test.wasmer.app/stream/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://ss-test.wasmer.app/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

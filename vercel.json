{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ss-test.wasmer.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://ss-test.wasmer.app/uploads/:path*"
    },
    {
      "source": "/media/:path*",
      "destination": "https://ss-test.wasmer.app/media/:path*"
    },
    {
      "source": "/i/:path*",
      "destination": "https://ss-test.wasmer.app/i/:path*"
    },
    {
      "source": "/stream/:path*",
      "destination": "https://ss-test.wasmer.app/stream/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://ss-test.wasmer.app/sitemap.xml"
    },
    {
      "source": "/:filename(.*\\.(?:gif|webp|png|jpe?g|svg|ico|webm|mp4))",
      "destination": "https://ss-test.wasmer.app/:filename"
    },
    {
      "source": "/app",
      "destination": "/app/index.html"
    },
    {
      "source": "/app/(.*\\.[a-zA-Z0-9]+)",
      "destination": "/app/$1"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
